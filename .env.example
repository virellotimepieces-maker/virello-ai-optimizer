# Copy to .env.local and set values locally. Do not commit filled files.

# Canonical public origin. Production: https://virello-ai-optimizer.vercel.app
# Local: http://127.0.0.1:43217
APP_URL=
ALLOWED_APP_ORIGINS=
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_SUBSCRIBER_USAGE_LIMIT=1000
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_SECRET_PREVIOUS=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_HANDLE=
SHOPIFY_TOKEN_ENCRYPTION_KEY=
# Default true. Partner development stores always use test charges.
# Set false only when live Shopify Billing charges should be created.
SHOPIFY_BILLING_TEST=true

# Leftover Vercel Production variables. Do not delete yet.
# Unused after Shopify Billing replaced Stripe checkout.
